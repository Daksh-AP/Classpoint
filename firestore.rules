rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : (request.auth.token.email != null && exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower()))
            ? get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data
            : {});
    }

    function isBoard() {
      return isAuthenticated() && (
        getUserDoc().role == 'board' || 
        (request.auth.token.email != null && request.auth.token.email.matches('.*board.*'))
      );
    }

    function isTeacher() {
      return isAuthenticated() && !isBoard();
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'superadmin' ||
        getUserDoc().role == 'superadmin'
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.role in ['admin', 'coordinator'] ||
        getUserDoc().role in ['admin', 'coordinator'] ||
        (request.auth.token.email != null &&
          exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower())) &&
          get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role in ['admin', 'coordinator'])
      );
    }

    function belongsToSchool(schoolId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.token.schoolId != null && request.auth.token.schoolId == schoolId) ||
        (getUserDoc().schoolId != null && getUserDoc().schoolId == schoolId)
      );
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update, write: if isAuthenticated() && (isAdmin() || (isTeacher() && request.auth.token.email.lower() == userId));
    }

    match /schools/{schoolId} {
      allow read: if isAuthenticated() && belongsToSchool(schoolId);
      allow write: if isAdmin() && belongsToSchool(schoolId);

      match /{document=**} {
        allow read: if isAuthenticated() && belongsToSchool(schoolId);
        allow write: if isAdmin() && belongsToSchool(schoolId);
      }

      match /timetables/{document=**} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
      }

      match /user_settings/{userId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || (belongsToSchool(schoolId) && (isAdmin() || isBoard() || isTeacher())));
      }

      match /smartboards/{smartboardId} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
      }

      match /grades/{gradeId} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId) && (isAdmin() || isTeacher());

        match /{document=**} {
          allow read, write: if isAuthenticated() && belongsToSchool(schoolId) && (isAdmin() || isTeacher());
        }
      }

      match /users/{userId} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId) && isAdmin();
      }

      match /parentChats/{chatId} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
        match /messages/{messageId} {
          allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
        }
      }

      match /parentAccounts/{document=**} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId) && (isAdmin() || isTeacher());
      }
      
      match /lessonEntries/{docId} {
        allow write: if belongsToSchool(schoolId) && (isAdmin() || isTeacher());
      }

      match /subjectStates/{docId} {
        allow write: if belongsToSchool(schoolId) && (isAdmin() || isTeacher());
      }

      match /announcements/{announcementId} {
        allow write: if isTeacher() && belongsToSchool(schoolId);
      }

      match /bulletins/{bulletinId} {
        allow read: if isAuthenticated() && belongsToSchool(schoolId);
        allow write: if (isAdmin() || isTeacher()) && belongsToSchool(schoolId);
      }

      match /alerts/{alertId} {
        allow read: if isAuthenticated() && belongsToSchool(schoolId);
        allow write: if (isAdmin() || isTeacher()) && belongsToSchool(schoolId);
      }

      match /shared_files/{fileId} {
        allow write: if isTeacher() && belongsToSchool(schoolId);
      }

      match /audit_logs/{logId} {
        allow create: if isTeacher() && belongsToSchool(schoolId);
      }

      match /deletedLogAudit/{logId} {
        allow create: if isTeacher() && belongsToSchool(schoolId);
        allow read, write: if isAdmin() || (isTeacher() && belongsToSchool(schoolId));
      }

      match /AbsenceImpactEvents/{eventId} {
        allow write: if isTeacher() && belongsToSchool(schoolId);
      }
      
      match /SessionSummaries/{summaryId} {
        allow write: if isTeacher() && belongsToSchool(schoolId);
      }
      
      match /CurriculumNodes/{nodeId} {
        allow write: if isTeacher() && belongsToSchool(schoolId);
      }
      
      match /substitutions/{subId} {
        allow read: if true;
        allow write: if isAdmin() && belongsToSchool(schoolId);
      }
    }
    
    match /{path=**}/students/{studentId} {
      allow read: if isAuthenticated() && belongsToSchool(resource.data.schoolId);
      allow write: if isAuthenticated() && (isAdmin() || isTeacher()) && (
        (request.resource.data.schoolId != null && belongsToSchool(request.resource.data.schoolId)) ||
        (resource != null && belongsToSchool(resource.data.schoolId))
      );
    }

    match /{path=**}/attendance/{dateKey} {
      allow read: if isAuthenticated() && belongsToSchool(resource.data.schoolId);
      allow write: if isAuthenticated() && (isAdmin() || isTeacher()) && (
        (request.resource.data.schoolId != null && belongsToSchool(request.resource.data.schoolId)) ||
        (resource != null && belongsToSchool(resource.data.schoolId))
      );
    }

    match /schoolStats/{statId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /one_time_pins/{pin} {
      allow create: if isTeacher() || isAdmin();
    }

    match /demo_requests/{leadId} {
      allow create, read, update, delete: if true;
    }

    match /timetables/{timetableId} {
      allow read, write: if isAuthenticated();
    }

    match /user_settings/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isBoard() || isTeacher());
    }
  }
}
