rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : (request.auth.token.email != null && exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower()))
            ? get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data
            : {});
    }

    function belongsToSchool(schoolId) {
      return isAuthenticated() && (
        schoolId == 'default_school' ||
        schoolId == null ||
        request.auth.token.schoolId == schoolId ||
        getUserDoc().schoolId == schoolId ||
        getUserDoc().schoolId == null ||
        request.auth.token.schoolId == null
      );
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated();
      match /{document=**} {
        allow read, write: if isAuthenticated();
      }
    }

    match /schoolData/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /smartboards/{smartboardId} {
      allow read, write: if isAuthenticated();
    }

    match /timetables/{timetableId} {
      allow read, write: if isAuthenticated();
      match /{document=**} {
        allow read, write: if isAuthenticated();
      }
    }

    match /user_settings/{userId} {
      allow read, write: if isAuthenticated();
      match /{document=**} {
        allow read, write: if isAuthenticated();
      }
    }

    match /shared_files/{fileId} {
      allow read, write: if isAuthenticated();
    }

    match /schoolStats/{statId} {
      allow read, write: if isAuthenticated();
    }

    match /one_time_pins/{pin} {
      allow read, write: if isAuthenticated();
    }

    match /demo_requests/{leadId} {
      allow create, read, update, delete: if true;
    }

    match /schools/{schoolId} {
      allow read, write: if isAuthenticated() && belongsToSchool(schoolId);

      match /{document=**} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
      }

      match /stats/{statId} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
      }

      match /timetables/{document=**} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
      }

      match /user_settings/{userId} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
        match /{document=**} {
          allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
        }
      }

      match /smartboards/{smartboardId} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
      }

      match /grades/{gradeId} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);

        match /{document=**} {
          allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
        }
      }

      match /users/{userId} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
        match /{document=**} {
          allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
        }
      }

      match /parentChats/{chatId} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
        match /messages/{messageId} {
          allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
        }
      }

      match /parentAccounts/{document=**} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
      }
      
      match /lessonEntries/{docId} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
      }

      match /subjectStates/{docId} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
      }

      match /announcements/{announcementId} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
      }

      match /bulletins/{bulletinId} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
      }

      match /alerts/{alertId} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
      }

      match /shared_files/{fileId} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
      }

      match /audit_logs/{logId} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
      }

      match /deletedLogAudit/{logId} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
      }

      match /AbsenceImpactEvents/{eventId} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
      }
      
      match /SessionSummaries/{summaryId} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
      }
      
      match /CurriculumNodes/{nodeId} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
      }
      
      match /substitutions/{subId} {
        allow read, write: if isAuthenticated();
      }

      match /calendar/{eventId} {
        allow read, write: if isAuthenticated() && belongsToSchool(schoolId);
      }
    }
    
    match /{path=**}/students/{studentId} {
      allow read, write: if isAuthenticated();
    }

    match /{path=**}/attendance/{dateKey} {
      allow read, write: if isAuthenticated();
    }
  }
}
