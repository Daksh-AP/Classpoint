{
    "name": "genatis-board",
    "version": "1.0.0",
    "private": true,
    "homepage": "./",
    "scripts": {
        "start": "npx concurrently \"npm run watch:css\" \"npm run react-start\" \"wait-on http://localhost:3000 && npm run electron-start\"",
        "react-start": "vite",
        "electron-start": "electron .",
        "build": "npm run build:css && vite build",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "eject": "echo 'eject not supported in vite'",
        "build:css": "tailwindcss -i ./src/index.css -o ./src/tailwind.css",
        "watch:css": "tailwindcss -i ./src/index.css -o ./src/tailwind.css --watch",
        "dist": "electron-builder",
        "electron-build": "rimraf dist APP-win32-x64 Genatis-win32-x64 && npm run build && npm run dist",
        "lint": "eslint \"src/**/*.{ts,tsx}\""
    },
    "main": "electron.cjs",
    "dependencies": {
        "@sentry/electron": "^7.15.0",
        "@sentry/react": "^10.67.0",
        "@tanstack/react-query": "^5.101.4",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/react-window": "^1.8.8",
        "autoprefixer": "^10.4.21",
        "file-saver": "^2.0.5",
        "firebase": "^12.5.0",
        "framer-motion": "^12.23.24",
        "lucide-react": "^0.552.0",
        "pdfjs-dist": "^5.6.205",
        "postcss": "^8.5.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-hot-toast": "^2.6.0",
        "react-pdf": "^10.4.1",
        "react-window": "^2.3.0",
        "sharp": "^0.34.5",
        "tailwindcss": "^3.4.18",
        "typescript": "^4.9.5",
        "uuid": "^13.0.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^20.19.43",
        "@vitejs/plugin-react": "^6.0.4",
        "electron": "^35.7.5",
        "electron-builder": "^24.13.3",
        "jsdom": "^29.1.1",
        "postcss-cli": "^11.0.1",
        "rimraf": "^6.1.2",
        "ts-morph": "^28.0.0",
        "vite": "^8.1.5",
        "vitest": "^4.1.10",
        "wait-on": "^9.0.3"
    },
    "overrides": {
        "nth-check": "^2.1.1",
        "postcss": "^8.5.6"
    },
    "build": {
        "appId": "com.genatis.app",
        "productName": "Genatis",
        "asar": false,
        "extends": "react-cra",
        "files": [
            "build",
            "public/electron.js",
            "package.json"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "build/icon.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Genatis"
        }
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "eslintConfig": {
        "extends": [
            "react-app"
        ]
    },
    "jest": {
        "moduleNameMapper": {
            "^uuid$": "uuid"
        }
    }
}
